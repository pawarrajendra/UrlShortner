# Replace every placeholder locally; do not commit .env or reuse demo secrets elsewhere.
POSTGRES_DB=urlshortener
POSTGRES_USER=urlshortener_bootstrap
POSTGRES_PASSWORD=replace-bootstrap-password
DATABASE_USERNAME=urlshortener_app
DATABASE_PASSWORD=replace-runtime-password
DATABASE_MIGRATION_USERNAME=urlshortener_migrator
DATABASE_MIGRATION_PASSWORD=replace-migration-password
PUBLIC_BASE_URL=http://localhost:8080
# Per-replica analytics bounds. Full stack overrides cleanup ownership to app-1 only.
ANALYTICS_WORKERS=2
ANALYTICS_QUEUE_CAPACITY=1000
ANALYTICS_MAX_QUEUE_WAIT=5s
ANALYTICS_CLEANUP_ENABLED=true
ANALYTICS_CLEANUP_BATCH_SIZE=1000
ANALYTICS_CLEANUP_INTERVAL=1h
# P5 full stack uses cache; baseline Compose keeps it disabled by default.
REDIRECT_CACHE_ENABLED=true
REDIRECT_CONSISTENCY_MODE=cached
REDIRECT_FALLBACK_CONCURRENCY=4
